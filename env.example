# Copy this file to ".env" and fill in your values. Never share or upload .env.

# From your Pesapal account (sandbox keys for testing, live keys for real money)
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=

# sandbox = test mode (no real money), live = real payments
PESAPAL_ENV=sandbox

# The public address of your site, no trailing slash.
# Online:  https://yourdomain.com      Testing on your PC: http://localhost:3000
BASE_URL=http://localhost:3000

# Password for the orders page at /admin?key=YOUR_PASSWORD (use a long random value)
ADMIN_KEY=

PORT=3000
